{
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:path:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.esoui.com/*"
        },
        {
          "url": "https://esotk.com"
        },
        {
          "url": "https://esotk.com/*"
        },
        {
          "url": "https://www.esologs.com/reports/*"
        },
        {
          "url": "https://esologs.com/reports/*"
        },
        {
          "url": "https://github.com/ESO-Toolkit/kalpa/releases/*"
        },
        {
          "url": "https://github.com/ESO-Toolkit/kalpa/issues/*"
        },
        {
          "url": "https://discord.gg/*"
        },
        {
          "url": "https://discord.com/channels/1375703719995244686/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOCUMENT/Elder Scrolls Online/**"
        },
        {
          "path": "$HOME/**/Elder Scrolls Online/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "$DOCUMENT/Elder Scrolls Online/**"
        },
        {
          "path": "$HOME/**/Elder Scrolls Online/**"
        }
      ]
    },
    "notification:default",
    "core:app:allow-version",
    "core:app:allow-tauri-version",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch"
  ]
}

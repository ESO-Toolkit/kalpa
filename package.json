{
  "name": "kalpa",
  "version": "0.1.0-beta.20",
  "private": true,
  "description": "A source-available desktop addon manager for Elder Scrolls Online",
  "author": "ESO-Toolkit",
  "license": "BUSL-1.1",
  "keywords": [
    "tauri",
    "addon-manager",
    "elder-scrolls-online",
    "eso",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ESO-Toolkit/kalpa.git"
  },
  "homepage": "https://github.com/ESO-Toolkit/kalpa",
  "bugs": {
    "url": "https://github.com/ESO-Toolkit/kalpa/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:native-slint": "node scripts/build-native-slint-sidecar.mjs",
    "build:release-assets": "npm run build && npm run build:native-slint",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"{src,public,scripts,e2e}/**/*.{ts,tsx,css,js,mjs}\"",
    "format:check": "prettier --check \"{src,public,scripts,e2e}/**/*.{ts,tsx,css,js,mjs}\"",
    "check": "tsc --noEmit && eslint src/ && prettier --check \"{src,public,scripts,e2e}/**/*.{ts,tsx,css,js,mjs}\"",
    "check:env": "node scripts/check-env.js",
    "check:versions": "node scripts/check-versions.js",
    "export:native-themes": "node prototypes/slint-kalpa/tools/export-native-themes.mjs",
    "export:native-skins": "node prototypes/slint-kalpa/tools/export-native-skins.mjs",
    "export:native-assets": "npm run export:native-themes && npm run export:native-skins",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert \"@packaged|@sandbox\"",
    "test:packaged": "node scripts/verify-packaged-build.mjs",
    "test:e2e:sandbox": "node scripts/run-sandbox-e2e.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-use-measure": "^2.1.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
